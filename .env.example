# ==============================================================================
# ENTERPRISE DESIGN SYSTEM & MCP SERVER CONFIGURATION
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Mode: 'stdio' for local IDE usage (default) | 'uvicorn' for cloud SSE hosting
MCP_MODE=stdio

# Cloud Hosting Configuration (used only when MCP_MODE=uvicorn)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Cloud Security (optional API key for securing Cloud SSE endpoints)
# MCP_API_KEY=your-secure-enterprise-api-key

# Azure DevOps Configuration (for Starter Kit Scaffolding)
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=YourProject
AZURE_DEVOPS_STARTER_REPO_ID=frontend-starter-kit

# Authentication (optional in local dev if using `az login` MSAL session)
# AZURE_DEVOPS_PAT=your-personal-access-token-if-not-using-az-login

# Artifactory / NPM Registry Configuration (Pointer only, tokens live in ~/.npmrc)
ARTIFACTORY_NPM_REGISTRY=https://artifactory.internal.company.com/artifactory/api/npm/virtual/

# Target Workspace Root (defaults to current workspace directory)
WORKSPACE_ROOT=.

# Browser Automation & Verification (System browser channel: 'msedge' or 'chrome')
PLAYWRIGHT_BROWSER_CHANNEL=msedge
