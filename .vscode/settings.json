{
  "mcpServers": {
    "enterprise-design-system": {
      "command": "python3",
      "args": ["server.py"],
      "env": {
        "MCP_MODE": "stdio"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-playwright"
      ],
      "env": {
        "PLAYWRIGHT_BROWSER_CHANNEL": "msedge"
      }
    }
  }
}
