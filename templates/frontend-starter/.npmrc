# ==============================================================================
# ENTERPRISE NPM CONFIGURATION - REGISTRY ROUTING ONLY
# Authentication tokens reside securely in workstation ~/.npmrc
# ==============================================================================

# Route all enterprise-scoped packages to internal Artifactory virtual repository
@enterprise:registry=https://artifactory.internal.company.com/artifactory/api/npm/virtual/

# Public registry fallback for standard open-source dependencies
registry=https://registry.npmjs.org/
always-auth=false
